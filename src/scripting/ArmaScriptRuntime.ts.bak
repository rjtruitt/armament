import type { ScriptContext, ScriptCommand } from './ArmaScriptTypes.js';

export interface RuntimeState {
  ctx: ScriptContext;
  variables: Record<string, any>;
  getVariable: (name: string) => any;
}

export function evalCondition(condition: string, state: RuntimeState): boolean {
  const resolved = interpolate(condition, state);
  const parts = resolved.trim().split(/\s+/);

  if (parts[0] === 'has_provider' && parts.length >= 2) {
    const providers = state.ctx.getConfig('providers') ?? [];
    return Array.isArray(providers) && providers.includes(parts[1]);
  }
  if (parts[0] === 'agent_exists' && parts.length >= 2) {
    const agents = state.ctx.getAgents();
    return agents.some(a => a.name === parts[1]);
  }
  if (parts[0] === 'distributed' && parts.length === 1) {
    return !!state.ctx.getConfig('distributed');
  }

  if (parts.length === 3) {
    const left = parts[0];
    const op = parts[1];
    const right = parts[2];
    const l = parseFloat(left);
    const r = parseFloat(right);
    if (!isNaN(l) && !isNaN(r)) {
      switch (op) {
        case '<': return l < r;
        case '>': return l > r;
        case '<=': return l <= r;
        case '>=': return l >= r;
        case '==': return l === r;
        case '!=': return l !== r;
      }
    }
    switch (op) {
      case '==': return left === right;
      case '!=': return left !== right;
    }
  }
  const val = resolved.trim();
  return val !== '' && val !== '0' && val !== 'false';
}

export function interpolate(text: string, state: RuntimeState): string {
  return text
    .replace(/\x00ESCAPED_DOLLAR\x00/g, '\x00DOLLAR\x00')
    .replace(/\\(\$)/g, '\x00DOLLAR\x00')
    .replace(/\$(\w+(?:\.\w+)*)/g, (_, name) => {
      if (name.includes('.')) {
        const parts = name.split('.');
        let obj = state.variables[`$${parts[0]}`];
        for (let i = 1; i < parts.length; i++) {
          obj = obj?.[parts[i]];
        }
        return String(obj ?? '');
      }
      const val = state.getVariable(`$${name}`);
      return String(val ?? '');
    })
    .replace(/\x00DOLLAR\x00/g, '$');
}

export function resolveArgs(cmd: ScriptCommand, state: RuntimeState): ScriptCommand {
  if (cmd.command === 'set' || cmd.command === 'unset' || cmd.command === 'foreach') {
    return {
      ...cmd,
      args: cmd.args.map((arg, i) => i === 0 ? arg : interpolate(arg, state)),
    };
  }
  return {
    ...cmd,
    args: cmd.args.map(arg => interpolate(arg, state)),
  };
}

export function getCollection(name: string, ctx: ScriptContext): any[] {
  if (name === 'agents') return ctx.getAgents();
  if (name === 'providers') return ctx.getConfig('providers') ?? [];
  return [];
}
