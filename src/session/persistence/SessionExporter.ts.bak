/** Exports sessions as directory copies or self-contained JSON bundles. */

import * as fs from 'node:fs';
import * as path from 'node:path';

/** Exports the current session to a directory or a single JSON document. */
export class SessionExporter {
  private _sessionDir: string;

  constructor(sessionDir: string) {
    this._sessionDir = sessionDir;
  }

  exportToDirectory(outputPath: string): void {
    if (!fs.existsSync(this._sessionDir)) {
      throw new Error('No active session to export');
    }
    fs.mkdirSync(outputPath, { recursive: true });
    fs.cpSync(this._sessionDir, outputPath, { recursive: true });
  }

  exportAsJson(): string {
    if (!fs.existsSync(this._sessionDir)) {
      throw new Error('No active session to export');
    }

    const manifest = path.join(this._sessionDir, 'active.session');
    if (!fs.existsSync(manifest)) {
      throw new Error('No manifest found');
    }

    const manifestData = JSON.parse(fs.readFileSync(manifest, 'utf-8'));
    const channelsDir = path.join(this._sessionDir, 'channels');
    const channels: Record<string, unknown> = {};

    if (fs.existsSync(channelsDir)) {
      for (const file of fs.readdirSync(channelsDir)) {
        if (file.endsWith('.state.json')) {
          const name = file.replace('.state.json', '');
          channels[name] = JSON.parse(fs.readFileSync(path.join(channelsDir, file), 'utf-8'));
        }
      }
    }

    return JSON.stringify({ manifest: manifestData, channels }, null, 2);
  }
}
