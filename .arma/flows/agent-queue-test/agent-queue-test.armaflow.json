{
  "name": "agent-queue-test",
  "description": "Queue test: dispatcher creates 5 tasks, 3 workers compete — tests TaskStore queuing",
  "trigger": {
    "type": "manual"
  },
  "nodes": [
    {
      "id": "dispatcher-0",
      "type": "spawn",
      "config": {
        "agentName": "dispatcher",
        "task": "Create 5 tasks using create_task: Audit-AccountService, Audit-OpptyHelper, Audit-TriggerChain, Audit-EmailHandler, Audit-DataService. Use list_tasks to verify all 5 pending. Write .workspace/queue-status.json. Call report_complete with task IDs and subjects. DO NOT claim or complete any tasks."
      }
    },
    {
      "id": "wait-1",
      "type": "wait",
      "config": {
        "agentName": "dispatcher"
      }
    },
    {
      "id": "task-2",
      "type": "task",
      "config": {
        "action": "log",
        "message": "Dispatcher created 5 tasks"
      }
    },
    {
      "id": "parallel-3",
      "type": "parallel",
      "config": {}
    },
    {
      "id": "worker-1-4",
      "type": "spawn",
      "config": {
        "agentName": "worker-1",
        "task": "Use list_tasks to find pending tasks. Use claim_task to claim one (owner=worker-1). Write a 2-line summary file in .workspace/. Use complete_task to mark it done. Repeat until no pending tasks. Write .workspace/worker-1-done.md. Call report_complete."
      }
    },
    {
      "id": "worker-2-5",
      "type": "spawn",
      "config": {
        "agentName": "worker-2",
        "task": "Use list_tasks to find pending tasks. Use claim_task to claim one (owner=worker-2). Write a 2-line summary file in .workspace/. Use complete_task to mark it done. Repeat until no pending tasks. Write .workspace/worker-2-done.md. Call report_complete."
      }
    },
    {
      "id": "worker-3-6",
      "type": "spawn",
      "config": {
        "agentName": "worker-3",
        "task": "Use list_tasks to find pending tasks. Use claim_task to claim one (owner=worker-3). Write a 2-line summary file in .workspace/. Use complete_task to mark it done. Repeat until no pending tasks. Write .workspace/worker-3-done.md. Call report_complete."
      }
    },
    {
      "id": "end-7",
      "type": "end",
      "config": {}
    },
    {
      "id": "join-8",
      "type": "join",
      "config": {
        "agentNames": [
          "worker-1",
          "worker-2",
          "worker-3"
        ]
      }
    },
    {
      "id": "task-9",
      "type": "task",
      "config": {
        "action": "log",
        "message": "All 3 workers completed"
      }
    },
    {
      "id": "auditor-10",
      "type": "spawn",
      "config": {
        "agentName": "auditor",
        "task": "Use list_tasks to verify ALL 5 tasks are completed. Read worker summary files in .workspace/. Write .workspace/queue-audit.md with which worker did which task. Call report_complete with audit results."
      }
    },
    {
      "id": "wait-11",
      "type": "wait",
      "config": {
        "agentName": "auditor"
      }
    },
    {
      "id": "task-12",
      "type": "task",
      "config": {
        "action": "log",
        "message": "Queue test complete — see .workspace/queue-audit.md"
      }
    }
  ],
  "edges": [
    {
      "from": "dispatcher-0",
      "to": "wait-1",
      "label": "wait"
    },
    {
      "from": "wait-1",
      "to": "task-2",
      "label": "chain"
    },
    {
      "from": "task-2",
      "to": "parallel-3",
      "label": "chain"
    },
    {
      "from": "parallel-3",
      "to": "worker-1-4"
    },
    {
      "from": "worker-1-4",
      "to": "worker-2-5"
    },
    {
      "from": "worker-2-5",
      "to": "worker-3-6"
    },
    {
      "from": "parallel-3",
      "to": "parallel-3"
    },
    {
      "from": "parallel-3",
      "to": "end-7"
    },
    {
      "from": "parallel-3",
      "to": "worker-1-4"
    },
    {
      "from": "worker-1-4",
      "to": "end-7"
    },
    {
      "from": "parallel-3",
      "to": "worker-2-5"
    },
    {
      "from": "worker-2-5",
      "to": "end-7"
    },
    {
      "from": "parallel-3",
      "to": "worker-3-6"
    },
    {
      "from": "worker-3-6",
      "to": "end-7"
    },
    {
      "from": "worker-3-6",
      "to": "end-7",
      "label": "chain"
    },
    {
      "from": "worker-1-4",
      "to": "join-8",
      "label": "join"
    },
    {
      "from": "worker-2-5",
      "to": "join-8",
      "label": "join"
    },
    {
      "from": "worker-3-6",
      "to": "join-8",
      "label": "join"
    },
    {
      "from": "join-8",
      "to": "task-9",
      "label": "chain"
    },
    {
      "from": "task-9",
      "to": "auditor-10",
      "label": "chain"
    },
    {
      "from": "auditor-10",
      "to": "wait-11",
      "label": "wait"
    },
    {
      "from": "wait-11",
      "to": "task-12",
      "label": "chain"
    }
  ]
}