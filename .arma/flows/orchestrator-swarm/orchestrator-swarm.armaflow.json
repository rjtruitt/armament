{
  "name": "orchestrator-swarm",
  "description": "Parallel specialist agents with fake-context synthesis",
  "trigger": {
    "type": "manual"
  },
  "nodes": [
    {
      "id": "parallel-0",
      "type": "parallel",
      "config": {}
    },
    {
      "id": "dead-code-1",
      "type": "spawn",
      "config": {
        "agentName": "dead-code",
        "task": "Scan src/ for dead exports, functions never called, config options read but never set. Report file:line with why it's dead."
      }
    },
    {
      "id": "bug-hunter-2",
      "type": "spawn",
      "config": {
        "agentName": "bug-hunter",
        "task": "Find logic bugs: promises not awaited, race conditions, off-by-one, null access without guards. Report file:line with code and fix."
      }
    },
    {
      "id": "perf-analyst-3",
      "type": "spawn",
      "config": {
        "agentName": "perf-analyst",
        "task": "Find performance problems: O(n²) loops, repeated work, sync I/O in hot paths. Report file:line with cost and fix."
      }
    },
    {
      "id": "end-4",
      "type": "end",
      "config": {}
    },
    {
      "id": "join-5",
      "type": "join",
      "config": {
        "agentNames": [
          "dead-code",
          "bug-hunter",
          "perf-analyst"
        ]
      }
    },
    {
      "id": "synthesizer-6",
      "type": "spawn",
      "config": {
        "agentName": "synthesizer"
      }
    },
    {
      "id": "synthesizer-7",
      "type": "task",
      "config": {
        "action": "seed",
        "target": "synthesizer",
        "role": "assistant",
        "content": "I've dispatched 3 specialists to audit the codebase. Let me collect their findings now."
      }
    },
    {
      "id": "collect-8",
      "type": "join",
      "config": {
        "agentNames": [
          "dead-code",
          "bug-hunter",
          "perf-analyst"
        ],
        "collectTarget": "synthesizer"
      }
    },
    {
      "id": "task-9",
      "type": "task",
      "config": {
        "action": "msg",
        "target": "synthesizer",
        "message": "All specialist reports are above. Deduplicate, remove speculation, keep only confirmed issues. Rank by severity: data-loss > logic bugs > perf sinks > dead code. Output a numbered list, max 25 items. Each: severity tag, file:line, 5-line snippet, the fix."
      }
    },
    {
      "id": "wait-10",
      "type": "wait",
      "config": {
        "agentName": "synthesizer"
      }
    },
    {
      "id": "task-11",
      "type": "task",
      "config": {
        "action": "log",
        "message": "Swarm audit complete"
      }
    }
  ],
  "edges": [
    {
      "from": "parallel-0",
      "to": "dead-code-1"
    },
    {
      "from": "dead-code-1",
      "to": "bug-hunter-2"
    },
    {
      "from": "bug-hunter-2",
      "to": "perf-analyst-3"
    },
    {
      "from": "parallel-0",
      "to": "parallel-0"
    },
    {
      "from": "parallel-0",
      "to": "end-4"
    },
    {
      "from": "parallel-0",
      "to": "dead-code-1"
    },
    {
      "from": "dead-code-1",
      "to": "end-4"
    },
    {
      "from": "parallel-0",
      "to": "bug-hunter-2"
    },
    {
      "from": "bug-hunter-2",
      "to": "end-4"
    },
    {
      "from": "parallel-0",
      "to": "perf-analyst-3"
    },
    {
      "from": "perf-analyst-3",
      "to": "end-4"
    },
    {
      "from": "perf-analyst-3",
      "to": "end-4",
      "label": "chain"
    },
    {
      "from": "dead-code-1",
      "to": "join-5",
      "label": "join"
    },
    {
      "from": "bug-hunter-2",
      "to": "join-5",
      "label": "join"
    },
    {
      "from": "perf-analyst-3",
      "to": "join-5",
      "label": "join"
    },
    {
      "from": "join-5",
      "to": "synthesizer-6",
      "label": "chain"
    },
    {
      "from": "synthesizer-7",
      "to": "synthesizer-6",
      "label": "seed"
    },
    {
      "from": "dead-code-1",
      "to": "collect-8",
      "label": "collect"
    },
    {
      "from": "bug-hunter-2",
      "to": "collect-8",
      "label": "collect"
    },
    {
      "from": "perf-analyst-3",
      "to": "collect-8",
      "label": "collect"
    },
    {
      "from": "collect-8",
      "to": "task-9",
      "label": "chain"
    },
    {
      "from": "synthesizer-6",
      "to": "wait-10",
      "label": "wait"
    },
    {
      "from": "wait-10",
      "to": "task-11",
      "label": "chain"
    }
  ]
}