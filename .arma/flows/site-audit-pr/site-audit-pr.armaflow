/name site-audit-pr
/description Audit armament-site docs against armament source code, fix discrepancies, add web-ui page, open PR
/trigger manual
/budget 15.00
/timeout 1800000
/allow . ../armament-site ../armament-web-ui ../iteratio ../flight-controller

/spawn rescan "Audit armament-site documentation. WORKING DIRECTORIES: armament-site at $(pwd)/../armament-site, armament at $(pwd), iteratio at $(pwd)/../iteratio, flight-controller at $(pwd)/../flight-controller, armament-web-ui at $(pwd)/../armament-web-ui. Use BASH with ls/cat/grep for reading external files (NOT read_file). STEP 1: bash ls ../armament-site/src/content/docs/ to list all docs. STEP 2: For each doc, bash cat the file, cross-reference claims against actual source using bash grep/find in src/ and sibling repos. STEP 3: Fix ONLY clear discrepancies in armament-site docs using bash with sed or echo to overwrite. Tag fixes with HTML comments. STEP 4: Create new page ../armament-site/src/content/docs/web-ui.md via bash cat > file. STEP 5: Write audit report: .workspace/site-audit-report.md using write_file. STEP 6: bash git status in ../armament-site to verify changes. STEP 7: Call report_complete with summary."
/wait rescan complete
/log "Rescan complete"

/spawn publisher "Create branch and PR in armament-site. WORKING DIR: ../armament-site. Use BASH for all git/gh commands. STEPS: bash cd ../armament-site && git status. bash git checkout -b docs/audit-sweep-\$(date +%Y%m%d). bash git add src/content/docs/. bash git commit -m 'docs: audit sweep — fix discrepancies vs armament source'. bash git push -u origin HEAD. bash gh pr create --title 'docs: Audit sweep — fix discrepancies vs armament source' --body 'Generated by armament rescan agent. Fixes discrepancies in armament-site docs vs actual armament/iteratio/flight-controller source code.' --base main. Report PR URL. Call report_complete."
/wait publisher complete
/log "PR created"
