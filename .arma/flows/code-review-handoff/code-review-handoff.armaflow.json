{
  "name": "code-review-handoff",
  "description": "Reviewer analyzes code, structured output feeds directly to fixer agent",
  "trigger": "manual",
  "nodes": [
    {
      "id": "reviewer-0",
      "type": "spawn",
      "config": {
        "agentName": "reviewer",
        "task": "Scan src/ for code quality issues: unused variables, missing error handling, inconsistent naming, potential bugs.",
        "completionSchema": {
          "fields": [
            {
              "name": "issues",
              "type": "string[]",
              "required": true,
              "description": "Each code issue: file:line description"
            },
            {
              "name": "priority",
              "type": "enum",
              "required": true,
              "description": "Highest priority issue level found",
              "enumValues": [
                "critical",
                "high",
                "medium",
                "low"
              ]
            },
            {
              "name": "files_affected",
              "type": "string[]",
              "required": true,
              "description": "List of file paths that need changes"
            },
            {
              "name": "suggested_approach",
              "type": "string",
              "required": false,
              "description": "High-level strategy for fixing these issues"
            }
          ],
          "purpose": "Structured findings get delivered to the fixer as a task brief",
          "sticky": true
        }
      }
    },
    {
      "id": "reviewer-1",
      "type": "spawn",
      "config": {
        "agentName": "reviewer"
      }
    },
    {
      "id": "fixer-2",
      "type": "spawn",
      "config": {
        "agentName": "fixer"
      }
    },
    {
      "id": "task-3",
      "type": "task",
      "config": {
        "action": "log",
        "message": "Code review handoff complete — fixer is working on the issues"
      }
    },
    {
      "id": "wait-4",
      "type": "wait",
      "config": {
        "agentName": "fixer"
      }
    },
    {
      "id": "task-5",
      "type": "task",
      "config": {
        "action": "log",
        "message": "All fixes applied — see #fixer"
      }
    }
  ],
  "edges": [
    {
      "from": "reviewer-0",
      "to": "reviewer-1",
      "label": "chain"
    },
    {
      "from": "reviewer-1",
      "to": "fixer-2",
      "label": "chain"
    },
    {
      "from": "fixer-2",
      "to": "task-3",
      "label": "chain"
    },
    {
      "from": "fixer-2",
      "to": "wait-4",
      "label": "wait"
    },
    {
      "from": "wait-4",
      "to": "task-5",
      "label": "chain"
    }
  ]
}