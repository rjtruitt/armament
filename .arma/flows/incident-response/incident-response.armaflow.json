{
  "name": "incident-response",
  "description": "Security incident response with parallel investigation and human approval",
  "trigger": {
    "type": "manual"
  },
  "nodes": [
    {
      "id": "parallel-0",
      "type": "parallel",
      "config": {}
    },
    {
      "id": "log-analyst-1",
      "type": "spawn",
      "config": {
        "agentName": "log-analyst",
        "task": "Search all log files for the incident timeframe. Extract: affected services, timestamps, user IDs, IP addresses. Report every finding with file:line."
      }
    },
    {
      "id": "code-investigator-2",
      "type": "spawn",
      "config": {
        "agentName": "code-investigator",
        "task": "Search codebase for recent changes related to the affected services. Look for: commits around the incident time, auth changes, config changes, dependency updates. Report file:line for every finding."
      }
    },
    {
      "id": "dependency-scanner-3",
      "type": "spawn",
      "config": {
        "agentName": "dependency-scanner",
        "task": "Check all dependencies for known vulnerabilities matching the incident characteristics. Report package name, version, CVE, and remediation."
      }
    },
    {
      "id": "end-4",
      "type": "end",
      "config": {}
    },
    {
      "id": "join-5",
      "type": "join",
      "config": {
        "agentNames": [
          "log-analyst",
          "code-investigator",
          "dependency-scanner"
        ]
      }
    },
    {
      "id": "incident-commander-6",
      "type": "spawn",
      "config": {
        "agentName": "incident-commander"
      }
    },
    {
      "id": "incident-commander-7",
      "type": "task",
      "config": {
        "action": "seed",
        "target": "incident-commander",
        "role": "assistant",
        "content": "I've dispatched 3 investigation teams. Gathering their reports now."
      }
    },
    {
      "id": "collect-8",
      "type": "join",
      "config": {
        "agentNames": [
          "log-analyst",
          "code-investigator",
          "dependency-scanner"
        ],
        "collectTarget": "incident-commander"
      }
    },
    {
      "id": "task-9",
      "type": "task",
      "config": {
        "action": "msg",
        "target": "incident-commander",
        "message": "All investigation reports are above. Synthesize a timeline of events, identify the root cause, assess impact (data/customers/systems), and recommend immediate remediation steps. Be specific — cite file:line for every claim."
      }
    },
    {
      "id": "wait-10",
      "type": "wait",
      "config": {
        "agentName": "incident-commander"
      }
    },
    {
      "id": "approval-11",
      "type": "approval",
      "config": {
        "prompt": "Investigation complete. Escalate to security team?",
        "gateType": "confirm"
      }
    },
    {
      "id": "task-12",
      "type": "task",
      "config": {
        "action": "log",
        "message": "Incident response complete"
      }
    }
  ],
  "edges": [
    {
      "from": "parallel-0",
      "to": "log-analyst-1"
    },
    {
      "from": "log-analyst-1",
      "to": "code-investigator-2"
    },
    {
      "from": "code-investigator-2",
      "to": "dependency-scanner-3"
    },
    {
      "from": "parallel-0",
      "to": "parallel-0"
    },
    {
      "from": "parallel-0",
      "to": "end-4"
    },
    {
      "from": "parallel-0",
      "to": "log-analyst-1"
    },
    {
      "from": "log-analyst-1",
      "to": "end-4"
    },
    {
      "from": "parallel-0",
      "to": "code-investigator-2"
    },
    {
      "from": "code-investigator-2",
      "to": "end-4"
    },
    {
      "from": "parallel-0",
      "to": "dependency-scanner-3"
    },
    {
      "from": "dependency-scanner-3",
      "to": "end-4"
    },
    {
      "from": "dependency-scanner-3",
      "to": "end-4",
      "label": "chain"
    },
    {
      "from": "log-analyst-1",
      "to": "join-5",
      "label": "join"
    },
    {
      "from": "code-investigator-2",
      "to": "join-5",
      "label": "join"
    },
    {
      "from": "dependency-scanner-3",
      "to": "join-5",
      "label": "join"
    },
    {
      "from": "join-5",
      "to": "incident-commander-6",
      "label": "chain"
    },
    {
      "from": "incident-commander-7",
      "to": "incident-commander-6",
      "label": "seed"
    },
    {
      "from": "log-analyst-1",
      "to": "collect-8",
      "label": "collect"
    },
    {
      "from": "code-investigator-2",
      "to": "collect-8",
      "label": "collect"
    },
    {
      "from": "dependency-scanner-3",
      "to": "collect-8",
      "label": "collect"
    },
    {
      "from": "collect-8",
      "to": "task-9",
      "label": "chain"
    },
    {
      "from": "incident-commander-6",
      "to": "wait-10",
      "label": "wait"
    },
    {
      "from": "wait-10",
      "to": "approval-11",
      "label": "chain"
    },
    {
      "from": "approval-11",
      "to": "task-12",
      "label": "chain"
    }
  ]
}