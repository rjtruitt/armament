/name doc-pipeline
/description Research → structured findings → pipe through formatter → writer
/trigger manual
/budget 12.00

# Step 1: Researcher with structured output
/chain researcher "Research the codebase architecture. Identify all modules, their responsibilities, and dependencies."
  /complete --purpose "Findings feed the documentation writer" --sticky
    /field modules string[] required "All module names found"
    /field dependencies string[] required "Module dependency pairs"
    /field circular string[] "Any circular dependency chains"

# Step 2: Pipe structured JSON through a formatter
/pipe researcher -> ./.arma/scripts/format-modules.py

# Step 3: Writer with predefined scope
/spawn writer
/seed writer user "You will receive a formatted architecture report."
/msg writer "The formatted module analysis is above. Write comprehensive documentation covering: module purposes, dependency graph highlights, and any circular dependency issues found."
/wait writer complete

# Step 4: Human approval gate
/approve "Publish documentation?"

/log "Documentation pipeline complete"
