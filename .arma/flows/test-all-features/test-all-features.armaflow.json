{
  "name": "test-all-features",
  "description": "Tests orchestrator\u2192spawn\u2192parallel\u2192join pattern with all injectors",
  "trigger": {
    "type": "manual"
  },
  "nodes": [
    {
      "id": "task-0",
      "type": "task",
      "config": {
        "action": "allow",
        "paths": [
          ".",
          "../armament",
          "../armament-web-ui",
          "/tmp",
          "/dev"
        ]
      }
    },
    {
      "id": "coordinator-1",
      "type": "spawn",
      "config": {
        "agentName": "coordinator",
        "task": "You are an orchestrator. Coordinate specialized workers to audit the workspace.",
        "role": "orchestrator"
      }
    },
    {
      "id": "parallel-2",
      "type": "parallel",
      "config": {}
    },
    {
      "id": "file-scanner-3",
      "type": "spawn",
      "config": {
        "agentName": "file-scanner",
        "task": "Use list_files and read_file to scan the project. Report all files by type.",
        "role": "worker"
      }
    },
    {
      "id": "code-checker-4",
      "type": "spawn",
      "config": {
        "agentName": "code-checker",
        "task": "Use grep to find TODO comments, FIXME tags, and deprecated APIs. Report counts.",
        "role": "worker"
      }
    },
    {
      "id": "perf-analyst-5",
      "type": "spawn",
      "config": {
        "agentName": "perf-analyst",
        "task": "Analyze scripts and configs for performance issues.",
        "role": "worker"
      }
    },
    {
      "id": "security-scan-6",
      "type": "spawn",
      "config": {
        "agentName": "security-scan",
        "task": "Scan for hardcoded secrets, exposed keys, unsafe patterns.",
        "role": "worker"
      }
    },
    {
      "id": "end-7",
      "type": "end",
      "config": {}
    },
    {
      "id": "coordinator-8",
      "type": "task",
      "config": {
        "action": "seed",
        "target": "coordinator",
        "role": "user",
        "content": "You are an expert project auditor. Please audit this codebase thoroughly."
      }
    },
    {
      "id": "coordinator-9",
      "type": "task",
      "config": {
        "action": "seed",
        "target": "coordinator",
        "role": "assistant",
        "content": "I'll spawn 4 workers running in parallel to audit different aspects."
      }
    },
    {
      "id": "join-10",
      "type": "join",
      "config": {
        "agentNames": [
          "coordinator",
          "file-scanner",
          "code-checker",
          "perf-analyst",
          "security-scan"
        ]
      }
    },
    {
      "id": "synthesizer-11",
      "type": "spawn",
      "config": {
        "agentName": "synthesizer",
        "task": "Take all worker findings. Synthesize them into a comprehensive audit report."
      }
    },
    {
      "id": "task-12",
      "type": "task",
      "config": {
        "action": "log",
        "message": "Full-feature test complete"
      }
    }
  ],
  "edges": [
    {
      "from": "task-0",
      "to": "coordinator-1",
      "label": "chain"
    },
    {
      "from": "coordinator-1",
      "to": "parallel-2",
      "label": "chain"
    },
    {
      "from": "parallel-2",
      "to": "file-scanner-3"
    },
    {
      "from": "file-scanner-3",
      "to": "code-checker-4"
    },
    {
      "from": "code-checker-4",
      "to": "perf-analyst-5"
    },
    {
      "from": "perf-analyst-5",
      "to": "security-scan-6"
    },
    {
      "from": "parallel-2",
      "to": "parallel-2"
    },
    {
      "from": "parallel-2",
      "to": "end-7"
    },
    {
      "from": "parallel-2",
      "to": "file-scanner-3"
    },
    {
      "from": "file-scanner-3",
      "to": "end-7"
    },
    {
      "from": "parallel-2",
      "to": "code-checker-4"
    },
    {
      "from": "code-checker-4",
      "to": "end-7"
    },
    {
      "from": "parallel-2",
      "to": "perf-analyst-5"
    },
    {
      "from": "perf-analyst-5",
      "to": "end-7"
    },
    {
      "from": "parallel-2",
      "to": "security-scan-6"
    },
    {
      "from": "security-scan-6",
      "to": "end-7"
    },
    {
      "from": "security-scan-6",
      "to": "end-7",
      "label": "chain"
    },
    {
      "from": "coordinator-8",
      "to": "coordinator-9",
      "label": "seed"
    },
    {
      "from": "coordinator-9",
      "to": "coordinator-1",
      "label": "seed"
    },
    {
      "from": "coordinator-1",
      "to": "join-10",
      "label": "join"
    },
    {
      "from": "file-scanner-3",
      "to": "join-10",
      "label": "join"
    },
    {
      "from": "code-checker-4",
      "to": "join-10",
      "label": "join"
    },
    {
      "from": "perf-analyst-5",
      "to": "join-10",
      "label": "join"
    },
    {
      "from": "security-scan-6",
      "to": "join-10",
      "label": "join"
    },
    {
      "from": "join-10",
      "to": "synthesizer-11",
      "label": "chain"
    },
    {
      "from": "synthesizer-11",
      "to": "task-12",
      "label": "chain"
    },
    {
      "from": "coordinator-1",
      "to": "file-scanner-3",
      "label": "child"
    },
    {
      "from": "coordinator-1",
      "to": "code-checker-4",
      "label": "child"
    },
    {
      "from": "coordinator-1",
      "to": "perf-analyst-5",
      "label": "child"
    },
    {
      "from": "coordinator-1",
      "to": "security-scan-6",
      "label": "child"
    }
  ],
  "allowPaths": [
    ".",
    "/home/rob/Documents/AiLegoPieces/armament",
    "/home/rob/Documents/AiLegoPieces/armament-web-ui",
    "/tmp",
    "/dev",
    "/workspace"
  ]
}