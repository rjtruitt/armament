# Armament Configuration
# Copy this file to .env and fill in your values.
# DO NOT commit .env to version control.

# LLM Provider API Keys (set only the ones you use)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# AWS Bedrock — uses ~/.aws/credentials; these are optional overrides
AWS_REGION=us-west-2
AWS_PROFILE=default

# MCP OAuth (for device code flow)
# Port for the local OAuth callback server (default: 3333)
MCP_OAUTH_PORT=3333

# Session / Budget
ARMAMENT_BUDGET_AMOUNT=5.00

# Optional: JWT secret for web UI support (if applicable)
JWT_SECRET=

# Database config (if using external storage — currently not used by armament core)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=armament
DB_USER=
DB_PASSWORD=
